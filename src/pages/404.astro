---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import trailLifeLogo from "../../assets/brand/TL_InLine_Logo_Tag_RGB.webp";
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Let's get you back on the trail with Troop 337."
>
  <section class="not-found">
    <div class="container">
      <div class="brand-mark">
        <Image src={trailLifeLogo} alt="Trail Life USA" width={220} height={81} />
        <span class="troop-badge">Troop 337</span>
      </div>

      <p class="kicker">Error 404</p>
      <h1>Looks Like You&rsquo;ve Wandered Off the Trail</h1>
      <p class="lede">
        The page you&rsquo;re looking for doesn&rsquo;t exist &mdash; maybe it moved, or the link took a
        wrong turn. Let&rsquo;s get you back on track.
      </p>

      <blockquote class="motto">
        <p>&ldquo;Walk Worthy&rdquo;</p>
        <cite>Colossians 1:10</cite>
      </blockquote>

      <div class="cta-row">
        <Button href="/">Back to Home</Button>
        <Button href="/leadership" variant="outline">Meet Our Leadership</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    background: var(--tl-off-white);
    padding-block: clamp(4rem, 10vw, 7rem);
    text-align: center;
  }

  .container {
    max-width: 640px;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 2.5rem;
  }

  .brand-mark img {
    height: 48px;
    width: auto;
  }

  .troop-badge {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--tl-brown);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-left: 0.85rem;
    border-left: 2px solid var(--tl-warm-gray);
  }

  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--tl-red);
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 1.1rem;
    color: var(--tl-text-muted);
    max-width: 46ch;
    margin: 0 auto 2.5rem;
  }

  .motto {
    margin: 0 auto 2.75rem;
  }

  .motto p {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--tl-brown);
    margin: 0 0 0.4rem;
  }

  .motto cite {
    font-style: normal;
    color: var(--tl-text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>
