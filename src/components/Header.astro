---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import trailLifeLogo from "../../assets/brand/TL_InLine_Logo_Tag_RGB.webp";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/leadership", label: "Leadership" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand">
      {/* TODO(Brad): this is the generic national mark — swap for the troop-337-customized version (troop number + URL beneath) once you generate one from the official template. */}
      <Image src={trailLifeLogo} alt="Trail Life USA" class="brand-logo" width={300} height={111} loading="eager" />
      <span class="brand-troop">Troop 337</span>
    </a>

    <button
      type="button"
      class="menu-toggle"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="nav-panel"
      aria-label="Toggle menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-panel" id="nav-panel">
      <nav aria-label="Primary">
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <Button href="/#meeting-info" class="header-cta">Visit Our Troop</Button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("nav-panel");

  toggle?.addEventListener("click", () => {
    const isOpen = panel?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });

  panel?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) {
      panel.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    }
  });
</script>

<style>
  .site-header {
    background: var(--tl-white);
    border-bottom: 1px solid var(--tl-warm-gray);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    padding-block: 0.85rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--tl-black);
    margin-right: auto;
    border-radius: 4px;
  }

  .brand-logo {
    height: 44px;
    width: auto;
  }

  .brand-troop {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--tl-brown);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-left: 0.6rem;
    border-left: 2px solid var(--tl-warm-gray);
    transition: color 0.15s ease;
  }

  .brand:hover .brand-troop {
    color: var(--tl-red);
  }

  .brand:active .brand-troop {
    color: var(--tl-red-dark);
  }

  .brand:focus-visible {
    outline: 2px solid var(--tl-red);
    outline-offset: 3px;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--tl-black);
    border-radius: 2px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--tl-red);
    outline-offset: 2px;
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-panel {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--tl-black);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  nav a:hover {
    color: var(--tl-red);
    border-bottom-color: var(--tl-orange);
  }

  nav a:active {
    color: var(--tl-red-dark);
    border-bottom-color: var(--tl-red-dark);
  }

  nav a[aria-current="page"] {
    border-bottom-color: var(--tl-red);
  }

  nav a:focus-visible {
    outline: 2px solid var(--tl-red);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .header-cta {
    padding: 0.6em 1.25em;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .menu-toggle {
      display: flex;
    }

    .nav-panel {
      display: none;
      order: 3;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding-top: 0.5rem;
    }

    .nav-panel.is-open {
      display: flex;
    }

    nav ul {
      flex-direction: column;
      gap: 0.25rem;
    }

    nav a {
      display: block;
      padding: 0.6rem 0.25rem;
    }

    .header-cta {
      text-align: center;
    }
  }
</style>
