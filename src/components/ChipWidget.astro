---
const WELCOME_MESSAGE =
  "Hey there! I'm Chip \u{1F43E} — ask me anything about Troop 337: meetings, joining, safety, our leaders, you name it.";
---

<div id="chip-widget" class="chip-widget">
  <button type="button" id="chip-bubble" class="chip-bubble" aria-label="Chat with Chip" aria-expanded="false">
    <svg class="chip-icon chip-icon--open" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
    <svg class="chip-icon chip-icon--close" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
    </svg>
  </button>

  <div id="chip-panel" class="chip-panel" hidden>
    <div class="chip-header">
      <div>
        <p class="chip-title">Chip</p>
        <p class="chip-subtitle">Troop 337 Assistant</p>
      </div>
      <button type="button" id="chip-panel-close" class="chip-panel-close" aria-label="Close chat">&times;</button>
    </div>

    <div id="chip-messages" class="chip-messages" role="log" aria-live="polite">
      <div class="chip-message chip-message--bot">{WELCOME_MESSAGE}</div>
    </div>

    <form id="chip-form" class="chip-form">
      <label for="chip-input" class="visually-hidden">Message Chip</label>
      <textarea id="chip-input" class="chip-input" placeholder="Ask a question…" rows="1" maxlength="2000"></textarea>
      <button type="submit" id="chip-send" class="chip-send" aria-label="Send message">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12h16M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  interface ChatMessage {
    role: "user" | "assistant";
    content: string;
  }

  const bubble = document.getElementById("chip-bubble");
  const panel = document.getElementById("chip-panel") as HTMLDivElement | null;
  const closeBtn = document.getElementById("chip-panel-close");
  const messagesEl = document.getElementById("chip-messages");
  const form = document.getElementById("chip-form") as HTMLFormElement | null;
  const input = document.getElementById("chip-input") as HTMLTextAreaElement | null;
  const sendBtn = document.getElementById("chip-send") as HTMLButtonElement | null;

  const history: ChatMessage[] = [];
  let isOpen = false;
  let isStreaming = false;

  function setOpen(open: boolean) {
    isOpen = open;
    panel?.toggleAttribute("hidden", !open);
    bubble?.setAttribute("aria-expanded", String(open));
    bubble?.classList.toggle("is-open", open);
    if (open) input?.focus();
  }

  bubble?.addEventListener("click", () => setOpen(!isOpen));
  closeBtn?.addEventListener("click", () => setOpen(false));

  input?.addEventListener("input", () => {
    if (!input) return;
    input.style.height = "auto";
    input.style.height = `${Math.min(input.scrollHeight, 96)}px`;
  });

  input?.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      form?.requestSubmit();
    }
  });

  function stripMarkdown(text: string) {
    return text.replace(/\*\*(.*?)\*\*/g, "$1").replace(/\*\*/g, "");
  }

  function appendMessage(role: "user" | "assistant", text: string) {
    if (!messagesEl) return null;
    const el = document.createElement("div");
    el.className = `chip-message chip-message--${role === "user" ? "user" : "bot"}`;
    el.textContent = text;
    messagesEl.appendChild(el);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return el;
  }

  function setStreaming(streaming: boolean) {
    isStreaming = streaming;
    if (sendBtn) sendBtn.disabled = streaming;
    if (input) input.disabled = streaming;
  }

  async function sendMessage(text: string) {
    history.push({ role: "user", content: text });
    appendMessage("user", text);
    setStreaming(true);

    const assistantEl = appendMessage("assistant", "");
    let assistantText = "";

    try {
      const res = await fetch("/api/chip", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history }),
      });

      if (!res.ok || !res.body) {
        throw new Error(`Request failed (${res.status})`);
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });

        const lines = buffer.split("\n\n");
        buffer = lines.pop() ?? "";

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed.startsWith("data:")) continue;
          const payload = trimmed.slice(5).trim();
          if (payload === "[DONE]") continue;

          try {
            const parsed = JSON.parse(payload);
            if (parsed.delta) {
              assistantText += parsed.delta;
              if (assistantEl) assistantEl.textContent = stripMarkdown(assistantText);
              if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
            } else if (parsed.error) {
              throw new Error(parsed.error);
            }
          } catch {
            // Ignore malformed SSE chunks.
          }
        }
      }

      if (assistantText) {
        history.push({ role: "assistant", content: assistantText });
      } else if (assistantEl) {
        assistantEl.textContent = "Sorry, I didn't catch that — could you try again?";
      }
    } catch (error) {
      console.error("[chip] chat error:", error);
      if (assistantEl) {
        assistantEl.textContent = "Sorry, I'm having trouble responding right now. Please try again in a moment.";
      }
    } finally {
      setStreaming(false);
      input?.focus();
    }
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (isStreaming || !input) return;
    const text = input.value.trim();
    if (!text) return;
    input.value = "";
    input.style.height = "auto";
    sendMessage(text);
  });
</script>

<style>
  .chip-widget {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    font-family: var(--font-body);
  }

  .chip-bubble {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--tl-red);
    color: var(--tl-white);
    border: none;
    box-shadow: 0 6px 20px rgba(1, 1, 1, 0.25);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .chip-bubble:hover {
    background: var(--tl-red-dark);
    transform: scale(1.05);
  }

  .chip-bubble:focus-visible {
    outline: 2px solid var(--tl-orange);
    outline-offset: 3px;
  }

  .chip-icon--close {
    display: none;
  }

  .chip-bubble.is-open .chip-icon--open {
    display: none;
  }

  .chip-bubble.is-open .chip-icon--close {
    display: block;
  }

  .chip-panel {
    position: absolute;
    right: 0;
    bottom: 4.25rem;
    width: min(360px, calc(100vw - 2.5rem));
    height: min(520px, calc(100vh - 8rem));
    background: var(--tl-white);
    border-radius: var(--radius);
    box-shadow: 0 20px 60px rgba(1, 1, 1, 0.3);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .chip-panel[hidden] {
    display: none;
  }

  .chip-header {
    background: var(--tl-red);
    color: var(--tl-white);
    padding: 0.9rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chip-title {
    font-weight: 800;
    margin: 0;
    font-size: 1rem;
  }

  .chip-subtitle {
    margin: 0;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .chip-panel-close {
    background: none;
    border: none;
    color: var(--tl-white);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.1rem 0.4rem;
  }

  .chip-panel-close:hover {
    color: var(--tl-orange);
  }

  .chip-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--tl-off-white);
  }

  :global(.chip-message) {
    max-width: 85%;
    padding: 0.6rem 0.85rem;
    border-radius: 12px;
    font-size: 0.9rem;
    line-height: 1.45;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  :global(.chip-message--bot) {
    align-self: flex-start;
    background: var(--tl-white);
    border: 1px solid var(--tl-warm-gray);
    color: var(--tl-text);
    border-bottom-left-radius: 4px;
  }

  :global(.chip-message--user) {
    align-self: flex-end;
    background: var(--tl-red);
    color: var(--tl-white);
    border-bottom-right-radius: 4px;
  }

  .chip-form {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid var(--tl-warm-gray);
    background: var(--tl-white);
  }

  .chip-input {
    flex: 1;
    resize: none;
    border: 1px solid var(--tl-warm-gray);
    border-radius: 10px;
    padding: 0.55rem 0.75rem;
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1.4;
    max-height: 96px;
  }

  .chip-input:focus-visible {
    outline: 2px solid var(--tl-red);
    outline-offset: 1px;
  }

  .chip-input:disabled {
    opacity: 0.6;
  }

  .chip-send {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 50%;
    border: none;
    background: var(--tl-red);
    color: var(--tl-white);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
  }

  .chip-send:hover:not(:disabled) {
    background: var(--tl-red-dark);
  }

  .chip-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 480px) {
    .chip-widget {
      right: 1rem;
      bottom: 1rem;
    }

    .chip-panel {
      width: calc(100vw - 2rem);
    }
  }
</style>
