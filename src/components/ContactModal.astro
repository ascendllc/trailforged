---
import { CONTACT_FORM_EMBED_URL } from "../lib/constants";
---

<dialog id="contact-modal" class="contact-modal" aria-label="Contact Troop 337">
  <div class="modal-header">
    <p class="modal-title">Contact Troop 337</p>
    <button type="button" class="modal-close" aria-label="Close">&times;</button>
  </div>
  <div class="modal-body">
    <iframe
      style="width: 100%; margin: 0px auto; display: block;"
      xml="lang"
      src={CONTACT_FORM_EMBED_URL}
      width="100%"
      height="815"
      frameborder="0"
      scrolling="yes"
      sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
      data-service="traillifeconnect"
      title="Contact Troop 337 form"
    ></iframe>
  </div>
</dialog>

<script>
  const modal = document.getElementById("contact-modal") as HTMLDialogElement | null;
  const closeBtn = modal?.querySelector(".modal-close");

  function openModal(event: Event) {
    event.preventDefault();
    modal?.showModal();
  }

  document.querySelectorAll("[data-contact-trigger]").forEach((el) => {
    el.addEventListener("click", openModal);
  });

  closeBtn?.addEventListener("click", () => modal?.close());

  modal?.addEventListener("click", (event: MouseEvent) => {
    if (!modal) return;
    const rect = modal.getBoundingClientRect();
    const clickedInsideDialog =
      rect.top <= event.clientY &&
      event.clientY <= rect.top + rect.height &&
      rect.left <= event.clientX &&
      event.clientX <= rect.left + rect.width;
    if (!clickedInsideDialog) modal.close();
  });
</script>

<style>
  .contact-modal {
    border: none;
    border-radius: var(--radius);
    padding: 0;
    width: min(640px, 92vw);
    max-height: 88vh;
    box-shadow: 0 20px 60px rgba(1, 1, 1, 0.35);
  }

  .contact-modal::backdrop {
    background: rgba(1, 1, 1, 0.55);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--tl-warm-gray);
  }

  .modal-title {
    font-weight: 700;
    color: var(--tl-red);
    margin: 0;
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    color: var(--tl-text-muted);
    padding: 0.1rem 0.4rem;
  }

  .modal-close:hover {
    color: var(--tl-red);
  }

  .modal-body {
    max-height: calc(88vh - 60px);
    overflow-y: auto;
  }
</style>
