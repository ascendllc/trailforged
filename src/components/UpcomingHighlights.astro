---
import SectionHeading from "./SectionHeading.astro";
import type { TroopEvent } from "../lib/events";
import { MEMBERS_CALENDAR_URL } from "../lib/constants";

interface Props {
  events: TroopEvent[];
  usingFallback: boolean;
}

const { events, usingFallback } = Astro.props;

const CATEGORY_COLORS: Record<string, string> = {
  Campout: "var(--tl-green)",
  "Special Event": "var(--tl-orange)",
  "Open House": "var(--tl-blue)",
};
const DEFAULT_CATEGORY_COLOR = "var(--tl-brown)";

function monthBadge(when: TroopEvent["when"]) {
  return when.month.slice(0, 3);
}

function whenDetail(when: TroopEvent["when"]) {
  const dayType = when.day_type === "weekend" ? "Weekend" : "Weekday";
  const span = when.multi_day ? "multiple days" : "single day";
  return `${dayType} · ${span}`;
}

function cleanDescription(text: string, max = 160) {
  let out = text.length > max ? `${text.slice(0, max).slice(0, text.slice(0, max).lastIndexOf(" "))}…` : text;
  if (!/[.!?…]$/.test(out)) out += "…";
  return out;
}
---

<section class="section section--warm">
  <div class="container">
    <SectionHeading eyebrow="What's Coming Up" title="Upcoming Highlights" />

    <div class="grid">
      {
        events.map((event) => (
          <article class="card">
            <div class="photo-wrap">
              {event.image?.url ? (
                <img class="photo" src={event.image.url} alt={event.image.alt ?? event.title} loading="lazy" />
              ) : (
                <div class="photo photo--placeholder" style={`background:${CATEGORY_COLORS[event.category] ?? DEFAULT_CATEGORY_COLOR}`}>
                  <span class="category-badge">{event.category}</span>
                </div>
              )}
              <span class="month-badge">{monthBadge(event.when)}</span>
              {event.image?.url && event.image?.credit && (
                <span class="photo-credit">{event.image.credit}</span>
              )}
            </div>
            <div class="card-body">
              <h3>{event.title}</h3>
              <p class="when-detail">{whenDetail(event.when)}</p>
              <p class="blurb">{cleanDescription(event.description)}</p>
            </div>
          </article>
        ))
      }
    </div>

    {
      usingFallback && (
        <p class="feed-note">
          We couldn't load live events just now — check back soon, or see the{" "}
          <a href={MEMBERS_CALENDAR_URL} target="_blank" rel="noopener noreferrer">full calendar</a> directly.
        </p>
      )
    }

    {
      !usingFallback && (
        <a class="see-all" href={MEMBERS_CALENDAR_URL} target="_blank" rel="noopener noreferrer">
          Members Can Access Our Full Calendar (Login Required) &rarr;
        </a>
      )
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .card {
    background: var(--tl-white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
  }

  .photo-wrap {
    aspect-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo--placeholder {
    display: flex;
    align-items: flex-start;
    padding: 0.6rem;
  }

  .category-badge {
    background: rgba(1, 1, 1, 0.35);
    color: var(--tl-white);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.3em 0.6em;
    border-radius: 999px;
  }

  .photo-credit {
    position: absolute;
    bottom: 0.35rem;
    left: 0.5rem;
    font-size: 0.65rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.55);
    text-shadow: 0 1px 2px rgba(1, 1, 1, 0.7);
    letter-spacing: 0.01em;
    pointer-events: none;
  }

  .month-badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: var(--tl-white);
    color: var(--tl-black);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    padding: 0.3em 0.7em;
    border-radius: 999px;
    box-shadow: 0 1px 4px rgba(1, 1, 1, 0.25);
  }

  .card-body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .card-body h3 {
    font-size: 1rem;
    margin: 0;
  }

  .when-detail {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--tl-brown);
    margin: 0;
  }

  .blurb {
    font-size: 0.9rem;
    color: var(--tl-text-muted);
    margin: 0;
    flex: 1;
  }

  .feed-note {
    margin: 1.5rem 0 0;
    font-size: 0.9rem;
    color: var(--tl-text-muted);
    text-align: center;
  }

  .see-all {
    display: block;
    text-align: center;
    margin-top: 2rem;
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
